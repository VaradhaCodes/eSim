// Resources for eSim.exe. The icon is the same workspace.ico the installer
// uses for shortcuts, so the exe, shortcuts and taskbar all present one
// identity. Version fields are static (2.5 product line); bump them together
// with the repo VERSION file.
#include <winver.h>

1 ICON "workspace.ico"

1 VERSIONINFO
FILEVERSION     2,5,0,0
PRODUCTVERSION  2,5,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "FOSSEE, IIT Bombay"
            VALUE "FileDescription",  "eSim - Open Source EDA Tool"
            VALUE "FileVersion",      "2.5.0.0"
            VALUE "InternalName",     "eSim"
            VALUE "LegalCopyright",   "GPL v3 - FOSSEE, IIT Bombay"
            VALUE "OriginalFilename", "eSim.exe"
            VALUE "ProductName",      "eSim"
            VALUE "ProductVersion",   "2.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
